# NOVA ESTATE — local env

# Gemini (чат Олесі)
GEMINI_API_KEY=
# Models (paid USD / 1M tokens ≈ input → output):
#   gemini-2.5-flash-lite  $0.10 → $0.40   budget
#   gemini-2.5-flash       $0.30 → $2.50   ★ current (best price/quality)
#   gemini-3.6-flash       $0.75 → $3.75   mid flash
#   gemini-3.5-flash       $1.50 → $9.00   smarter flash
#   gemini-2.5-pro         $1.25 → $10.00  legacy (often 404 for new keys)
#   gemini-3.1-pro-preview $2.00 → $12.00  expensive Pro
GEMINI_MODEL=gemini-3.8-flash
# Lower = fewer invented facts (0.2–0.3 for sales chat)
GEMINI_TEMPERATURE=0.25

# Google Sheets → spreadsheet "Rag агенты", tab Лист2
# columns: createdAt name phone format details date time when summary status timezone source
# (legacy keys service/doctor/slotLabel/concern still accepted by Apps Script)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
GOOGLE_SHEETS_SHEET_NAME=Лист2
GOOGLE_SHEETS_SPREADSHEET_ID=1rfUnwnytsQbOeX2L2vw-GZS3hiJ5Kn0UD9ORBoh9RYA

# Optional Telegram notify
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
